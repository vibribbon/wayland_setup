				<command>foot -w 1024x960 -H sh -c "sudo apt-get update &amp;&amp; sudo apt-get upgrade &amp;&amp; sudo apt-get autoclean &amp;&amp; sudo apt-get autoremove &amp;&amp; sudo flatpak update &amp;&amp; echo '--UPDATES COMPLETE--'"</command>
