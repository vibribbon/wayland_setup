				<command>foot -w 1024x600 "nvtop"</command>
			</action>
		</item>
		<item label="GPU Overclock*">
			<action name="Execute">
				<command>flatpak run io.github.ilya_zlobintsev.LACT</command>
			</action>
		</item>
		<item label="Power Usage">
