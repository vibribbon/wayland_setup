			</action>
		</item>
		
		<separator />
		
		<item label="Mount 500gb shared">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "sudo mount -t ext4 /dev/sdb1 /mnt/m_shared_500gb/"</command>
			</action>
		</item>
		<item label="Mount NAS Public">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "sudo /sbin/mount.cifs //192.168.1.5/s_public /mnt/m_nas_public -o username=vibri,domain=WORKGROUP,vers=3.11,sec=ntlmssp,rw,uid=1000,gid=1000,file_mode=0644,dir_mode=0755,noperm,mfsymlinks,_netdev"</command>
			</action>
		</item>
		<item label="Mount NAS Private">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "sudo /sbin/mount.cifs //192.168.1.5/s_private /mnt/m_nas_private -o username=vibri,domain=WORKGROUP,vers=3.11,sec=ntlmssp,rw,uid=1000,gid=1000,file_mode=0644,dir_mode=0755,noperm,mfsymlinks,_netdev"</command>
			</action>
		</item>
		
		<menu id="m_eject_device" label="Eject media">
			<item label="Eject sdb1">
				<action name="Execute">
					<command>foot -w 800x600 -H sh -c "sudo umount /dev/sdb1"</command>
				</action>
			</item>
			<item label="Eject sdc1">
				<action name="Execute">
					<command>foot -w 800x600 -H sh -c "sudo umount /dev/sdc1"</command>
				</action>
			</item>
			<item label="Eject sdd1">
				<action name="Execute">
					<command>foot -w 800x600 -H sh -c "sudo umount /dev/sdd1"</command>
				</action>
			</item>
		</menu>
			
		<separator />
		
		<item label="Show installed apps">
			<action name="Execute">
				<command>foot -w 1024x960 -H sh -c "sudo list_manual_apps"</command>
			</action>
		</item>
		<item label="Show installed flatpaks">
			<action name="Execute">
				<command>foot -w 1024x960 -H sh -c "sudo flatpak list"</command>
			</action>
		</item>
		
		<separator />
		
		
		<!-- clear caches -->
		<item label="Clear caches (free RAM)">
			<action name="Execute">
				<command>foot -w 1024x960 sh -c "sudo sync &amp;&amp; echo 3 | sudo tee /proc/sys/vm/drop_caches"</command>
			</action>
		</item>
		
		<!-- kill process -->
		<item label="Kill current window">
			<action name="Kill" />
		</item> 
	</menu>
	

	<!-- show the diagnostic menu -->
	<menu id="m_diag" label="Diagnostic">
		
		<!-- general -->
		<item label="Process Explorer">
			<action name="Execute">
