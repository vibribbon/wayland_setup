			</action>
		</item>
		<separator />
		
		<!-- storage -->
		<item label="HDD Usage">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "ncdu /"</command>
			</action>
		</item>	
		<item label="Mountpoints">
