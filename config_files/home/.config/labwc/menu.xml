				<command>foot -w 800x600 -H sh -c "lsblk"</command>
			</action>
		</item>	
		<item label="HDD io">
			<action name="Execute">
				<command>foot -w 1024x960 -H sh -c "sudo iotop"</command>
			</action>
		</item>	
		<item label="Open files">
			<action name="Execute">
				<command>foot -w 1920x1080 -H sh -c "lsof"</command>
			</action>
		</item>
		<item label="Locate Duplicates (home)">
			<action name="Execute">
				<command>foot -w 1920x1080 -H sh -c "fdupes ~/ -r -1 -t"</command>
			</action>
		</item>
		<separator />
		
		<!-- other -->
		<item label="Active users">
			<action name="Execute">
				<command>foot -w 800x600 -H sh -c "w"</command>
			</action>
		</item>	
		
		<separator />
		
		<menu id="m_logs" label="System Logs">
			<item label="Log - High priority errors">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -p 3 -xb"</command>
				</action>
			</item>
			<item label="Log - All last 24hrs">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -o short-full --since '1 days ago'"</command>
				</action>
			</item>
			<item label="Log - Last 20 errors">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -n 20 -o short-full --priority=0..3"</command>
				</action>
			</item>
			<item label="Log - Last 20 warnings">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -n 20 -o short-full --priority=4"</command>
				</action>
			</item>
			<item label="Log - boot">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -b -o short-full"</command>
				</action>
			</item>
			<item label="Log - kernel">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -k -o short-full"</command>
				</action>
			</item>
			<item label="Log - real time">
				<action name="Execute">
					<command>foot -w 1920x1080 -H sh -c "sudo journalctl -f -o short-full"</command>
				</action>
			</item>
		</menu>	
	</menu>


