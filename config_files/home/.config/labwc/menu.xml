				<command>foot -w 1024x960 -H sh -c "free -m -w -t"</command>
			</action>
		</item>
		<item label="Memory Usage Continuous">
			<action name="Execute">
				<command>foot -w 1024x960 -H sh -c "free -m -L -s 5"</command>
			</action>
		</item>
		<item label="GPU Usage">
