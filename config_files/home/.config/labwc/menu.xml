			</action>
		</item>
		<item label="Network Connections">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "sudo iftop -B -P"</command>
			</action>
		</item>	
		<item label="Network Bandwidth">
			<action name="Execute">
				<command>foot -w 800x600 sh -c "sudo nethogs -C -a"</command>
			</action>
		</item>
		<item label="Internet Speed (fast.com)">
